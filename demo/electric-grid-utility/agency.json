  "goals": [
    {
      "id": "e1678b51-3bc9-4531-ac51-10839660ccf2",
      "code": "G-1",
      "title": "Keep the grid stable and within reliability standards",
      "description": "Grid frequency and load are monitored in real time, reliability compliance metrics are reported, and contingency and blackstart drills are conducted, keeping the grid stable.",
      "ordinality": 0,
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "6f9def8a-a831-43b5-a0f2-f67140ceb51c",
      "code": "G-2",
      "title": "Restore outages quickly and safely",
      "description": "Outages are detected and classified, line crews are dispatched to restore service, and affected customers are told restoration status, so power returns quickly and safely.",
      "ordinality": 0,
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "a20996b2-57d7-4ec2-9f2c-feb2504c61d6",
      "code": "G-3",
      "title": "Maintain generation, transmission, and distribution assets proactively",
      "description": "Substation and line assets and generation equipment are maintained on a preventive schedule, and equipment failures are investigated, keeping the physical system healthy.",
      "ordinality": 0,
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "171ebbb9-d7bf-59dd-a19c-a05d75d34d6f",
      "code": "G-4",
      "title": "Know and control the utility's key risks",
      "description": "Threats to the grid are listed, the controls against them are checked, and gaps are closed with named work.",
      "ordinality": 0,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
