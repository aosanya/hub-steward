  "values": [
    {
      "id": "253330e3-da9c-4a34-a5e4-d4319c7a13e6",
      "code": "V-1",
      "text": "Grid stability decisions in the control room are never delayed for sign-off during an active event.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "655d27fa-e48c-4174-a18d-ef355f0b5505",
      "code": "V-2",
      "text": "A line crew never works a de-energized line without a verified safety clearance.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "6f9997a7-3f65-4033-8b71-02df9f77a48b",
      "code": "V-3",
      "text": "Outage restoration status is communicated to customers proactively, not only on request.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "1ca1a744-1103-4b4d-b3e3-ce49b352198a",
      "code": "RU-1",
      "text": "No line crew is dispatched to a fault without a documented safety clearance (lockout/tagout) first.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "c517ef98-220e-4053-9eae-28b8775fb2c8",
      "code": "RU-2",
      "text": "A reliability compliance report is filed with the regulator on the statutory deadline, with no extensions absent a filed exception.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "65ea3f8f-93d8-4471-af77-dbea1c7aa4f4",
      "code": "RU-3",
      "text": "Any equipment failure causing an outage over 4 hours triggers a mandatory root-cause investigation.",
      "created_at": "2026-09-15T15:38:58Z",
      "last_updated": "2026-09-15T15:38:58Z",
      "deleted": false
    },
    {
      "id": "b7582d95-6642-5f8e-8dda-ff29e91189dc",
      "code": "RU-4",
      "text": "No transmission line is returned to service after a storm until a patrol has cleared it of damage and debris.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "97c9fe95-03bb-5d34-a7c3-4cfea48b9b60",
      "code": "RU-5",
      "text": "Control-room and SCADA accounts use multi-factor sign-in, and remote access to protection relays is disabled outside a logged maintenance window.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "d60b57f0-7af2-5bc3-8064-f9c0e7082d89",
      "code": "RU-6",
      "text": "Every critical transformer has a tested spare or a mutual-aid loan agreement on file, and its oil is sampled at each maintenance interval.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "4c0d4628-7842-5aa2-87ca-564d6f71986a",
      "code": "RU-7",
      "text": "A blackstart drill that misses its target restart time raises a corrective action before the next drill.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "20ec1ddd-e73e-5e0e-a94d-5dd906dbeb18",
      "code": "RU-8",
      "text": "Vegetation within the clearance distance of a line is cut on the annual cycle, and a missed span is reported to the Risk owner.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
