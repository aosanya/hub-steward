      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "bd63bab3-d3dc-5eb5-93a2-98506d478b4a",
      "code": "R-2",
      "name": "Member",
      "permissions": [
        "chat.archive",
        "group.join",
        "mount.list"
      ],
      "description": "A registered member of the lab. Uses the lab during opening hours, books seats, connects to the members' Wi-Fi with a personal login and asks Hub Steward in the lab's chat.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "26e27223-8575-5f10-b335-86619874dd0f",
      "code": "R-3",
      "name": "Hub Steward",
      "permissions": [
        "ai.use",
        "chat.post",
        "chat.thread",
        "document.read",
        "document.search",
        "form.answers.read",
        "form.compose",
        "form.send",
        "group.read",
        "member.read",
        "risk.read"
      ],
      "description": "The lab's AI agent. Answers members in the lab's chat from the lab's documents, in the language the member writes in (English, Swahili or German), at any time. Drafts access requests and seat bookings for the lab manager to approve, and watches the lab's network. It never approves its own drafts.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    }
  ],
