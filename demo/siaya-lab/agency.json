    },
    {
      "id": "aa6d973e-44c1-523a-9590-7c3d7acc0330",
      "code": "O-2",
      "goal_id": "0f3a5e5a-1b6a-5591-94b7-ac545ceb3921",
      "title": "Book seats within the booking rules",
      "description": "Hub Steward drafts a booking for one or two hours, within each member's weekly hours and how far ahead they may book; the lab manager confirms it and the member is told.",
