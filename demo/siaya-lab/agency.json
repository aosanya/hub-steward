  "values": [
    {
      "id": "115246ef-e6dc-584d-9f44-eb71178e5ef3",
      "code": "V-1",
      "text": "The lab is shared by everyone who comes; its rules keep it open, safe and useful for all members.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "a4efea8f-6025-53f8-a9d7-3427e6e3c8d3",
      "code": "RU-1",
      "text": "Any registered member may use the lab during opening hours; a new member is approved by the lab manager and finishes set-up at the lab terminal.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "cbf53194-af33-5236-8544-7a584c8f13d3",
      "code": "RU-2",
      "text": "Members sign in at the desk when they arrive, showing their member barcode, and sign out when they leave.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "357fa839-86be-5edc-9d4c-f5d84fe23846",
      "code": "RU-3",
      "text": "Use only the seat you booked; one seat per member at a time.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "22d9329f-1715-5cb8-a258-54a040880b9d",
      "code": "RU-4",
      "text": "No food at the seats; water in a closed bottle is fine.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "35eec5a8-15a6-5ade-a3d1-119579c56920",
      "code": "RU-5",
      "text": "Do not unplug, open or move equipment, and do not install software on the lab computers; report faults to the staff on duty or to Hub Steward.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "eb81337f-cda2-5956-8e29-43043a18b491",
      "code": "RU-6",
      "text": "The lab computers are cleared at the end of each day; members save their work to their own account or a USB stick.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "0b2a214e-a342-55e7-8b80-5456687707fb",
      "code": "RU-7",
      "text": "Children under 14 come with an adult member.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "b889cc60-1765-52e4-a100-c706be28a815",
      "code": "RU-8",
      "text": "Harassment, threats and discrimination are not allowed, and nobody uses another member's account, barcode or Wi-Fi login.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "d097ea4c-4e17-5bef-93f9-e4e6ec92ad84",
      "code": "RU-9",
      "text": "A booking is for one or two hours, up to six hours a week per member, made up to seven days ahead.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "aea2d1f7-c45e-5d63-a7db-13384e685613",
      "code": "RU-10",
      "text": "A seat is given to someone else when its member is more than 15 minutes late without telling the lab; a member who misses three bookings in a month without cancelling may not book the following week.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "3fd25c42-56f7-5706-9468-612413782144",
      "code": "RU-11",
      "text": "Unbooked seats are free to walk-in members for one hour at a time; booked members go first; the lab manager may reserve seats for a course or a member group.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "0ffe99fc-3dbe-57da-b4ad-69a72cb962e0",
      "code": "RU-12",
      "text": "Up to two devices per member on the members' Wi-Fi, a fair-use allowance of 2 GB a day, and no large downloads, film streaming or file sharing during opening hours.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "489c3463-f44c-5e6e-89ea-f008b95f732a",
      "code": "RU-13",
      "text": "Hub Steward drafts access requests and bookings; only the lab manager approves them.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    },
    {
      "id": "6136b121-d18c-575f-b4a4-0b1fd5b19325",
      "code": "RU-14",
      "text": "Hub Steward answers in the language the member writes in, from the lab's documents.",
      "created_at": "2026-10-21T00:00:00Z",
      "last_updated": "2026-10-21T00:00:00Z",
      "deleted": false
    }
  ],
