  "roles": [
    {
      "id": "6d2d8afd-0e8b-5597-a92c-8dcaa2089362",
      "code": "R-1",
      "name": "Lab manager",
      "permissions": [
        "chat.archive",
        "group.join",
        "mount.list"
      ],
      "description": "Runs the lab. Approves access requests, confirms seat bookings drafted by Hub Steward, may reserve seats for a course or a member group, and acts on network problems Hub Steward reports. Access requests and bookings made outside opening hours are confirmed on the next opening day. This role is held by a person.",
