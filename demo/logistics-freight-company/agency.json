  "goals": [
    {
      "id": "2a8f2551-1a5e-44b0-b34e-d710cac20240",
      "code": "G-1",
      "title": "Move every shipment on time with an unbroken chain of custody",
      "description": "Every shipment moves on time with unbroken custody, from receipt and staging through route dispatch to confirmed proof of delivery.",
      "ordinality": 1,
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "5cf8d8eb-2020-49ac-b391-fa8a91b7b20a",
      "code": "G-2",
      "title": "Clear customs and trade compliance without delay or penalty",
      "description": "Cross-border shipments clear customs without delay or penalty through prepared documentation, correct tariff classification and declaration, and handled holds and inspections.",
      "ordinality": 2,
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "07ccaf49-b4ec-4d8d-839d-b3713d04b68c",
      "code": "G-3",
      "title": "Resolve customer shipment issues and claims fairly",
      "description": "Customer shipment inquiries are logged and triaged, lost or damaged freight claims investigated, and resolutions and reimbursements issued fairly.",
      "ordinality": 3,
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "f2fccb3b-508f-5e36-a683-860224063b89",
      "code": "G-4",
      "title": "Keep known risks controlled",
      "description": "The risks that can stop a shipment, a customs clearance or a claim are listed, their controls are checked, and gaps become work.",
      "ordinality": 4,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
