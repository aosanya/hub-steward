  "values": [
    {
      "id": "9311f7e4-f584-4af3-bacc-0c65496b97bd",
      "code": "V-1",
      "text": "Every shipment's custody handoff is logged — a shipment is never 'somewhere in transit' with no record.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "a88364c6-5581-4068-bb60-34799b476028",
      "code": "V-2",
      "text": "Customs documentation is prepared before the shipment departs, never backfilled after a hold.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "a8edc073-069a-4235-8bde-b2efd8932137",
      "code": "V-3",
      "text": "A freight claim is investigated on the evidence, not settled to make the complaint go away.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "c881de8b-d100-4150-b32b-f68648eadfb9",
      "code": "RU-1",
      "text": "No shipment leaves the warehouse without a signed chain-of-custody handoff record.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "b7ec6ac0-c483-4c8e-8f21-46b16b1d214d",
      "code": "RU-2",
      "text": "A misclassified tariff code is corrected and re-filed within 24 hours of discovery.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "5c9a387c-e176-453d-b7a8-40b2c7b040c5",
      "code": "RU-3",
      "text": "A freight claim is acknowledged within 2 business days of filing.",
      "created_at": "2026-09-15T15:36:34Z",
      "last_updated": "2026-09-15T15:36:34Z",
      "deleted": false
    },
    {
      "id": "51987c25-a086-5a63-8242-419fc482db2c",
      "code": "RU-4",
      "text": "A driver who finds a seal broken or a load shifted at pickup reports it to the dispatcher before leaving the yard.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "cc05a578-10e0-5475-8155-044c344ef70a",
      "code": "RU-5",
      "text": "A vehicle with an overdue safety inspection is not assigned to a route until the fleet manager clears it.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "94a6e561-36c5-5d33-8f25-faddde6dd79d",
      "code": "RU-6",
      "text": "Restricted or dangerous goods and sanctioned parties are screened before a shipment is accepted for cross-border carriage.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "c59010a6-6c15-5369-b5f6-98c1cf945f3d",
      "code": "RU-7",
      "text": "Goods of high value are staged in the caged area and moved only with two signatures.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "bd23de93-1846-51ca-9d34-27633be03ad0",
      "code": "RU-8",
      "text": "The risk owner reviews the risk list every month, and a control gap raised in the review is closed or re-dated within 30 days.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
  "value_attachments": [
    {
