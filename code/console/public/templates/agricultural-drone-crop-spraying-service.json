  "work_items": [
    {
      "id": "1429b792-b5b1-447d-9414-21740bdb3c73",
      "code": "WI-1",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Receive and validate a spray job request",
      "description": "",
      "prompt": "Log the incoming request from the farmer or Client Success Manager: crop, target pest/weed, requested date, field location. Reject or flag any request missing a usable field boundary before it moves to planning.",
      "ordinality": 1,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "bd5414f3-b1fb-413d-b1dd-4fdfe9a5444f"
    },
    {
      "id": "0ca4834a-bd53-496a-9bb9-3be471fb698c",
      "code": "WI-2",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Confirm field boundary against flight authorization",
      "description": "",
      "prompt": "Confirm the client's field boundary GeoJSON matches the flight plan before dispatching the drone; if the area exceeds the authorized permit radius or sits inside restricted airspace, escalate to the Chief Pilot before takeoff.",
      "ordinality": 2,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "a69ffd28-2c2f-4748-925a-2f7b4a3aa87c"
    },
    {
      "id": "743b24a0-6593-447c-8c7d-e7448e45a7a9",
      "code": "WI-3",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Generate the agronomic spray prescription",
      "description": "",
      "prompt": "Set the chemical mix, application rate per hectare and nozzle setting for the target crop and pest. Never exceed the product label's maximum rate, and cite the label reference in the prescription record.",
      "ordinality": 3,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "f222e7d6-7a29-4f7f-b08a-f1d7cd2c8d37"
    },
    {
      "id": "053cfd59-f84f-43af-a79f-bd6eb7f0971c",
      "code": "WI-4",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Schedule the flight window against the forecast",
      "description": "",
      "prompt": "Pick a flight slot where forecast wind stays under the product label's maximum and no rain is expected within the label's re-entry/wash-off window. Move the job to standby rather than force a marginal window.",
      "ordinality": 4,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "499d45de-dbad-4e8b-8ed5-8bd4d0e062ac"
    },
    {
      "id": "00f1852f-f6cb-42ac-af92-ae3d7d9d1fa2",
      "code": "WI-5",
      "workflow_id": "bac550da-96dc-45b5-bf98-d1fcd7868dd8",
      "title": "Run the pre-flight safety and airworthiness check",
      "description": "",
      "prompt": "Complete the pre-flight checklist: battery charge and health, rotor and frame integrity, spray-system leak check, firmware/GPS lock. Do not clear a drone for takeoff with any open item.",
      "ordinality": 1,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "438c2278-235b-4f76-9942-f0a3c74d6ef5"
    },
    {
      "id": "cc368bf1-9570-41c4-8878-54bc83d87259",
      "code": "WI-6",
      "workflow_id": "bac550da-96dc-45b5-bf98-d1fcd7868dd8",
      "title": "Execute the spray flight and log telemetry",
      "description": "",
      "prompt": "Fly the planned pattern at the prescribed rate, keeping battery and tank level visible throughout. Abort and land if wind exceeds the label threshold mid-flight rather than finishing the pass.",
      "ordinality": 2,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "f222e7d6-7a29-4f7f-b08a-f1d7cd2c8d37"
    },
    {
      "id": "7c574529-49bc-4bef-a96b-bb1b7c8fe22b",
      "code": "WI-7",
      "workflow_id": "bac550da-96dc-45b5-bf98-d1fcd7868dd8",
      "title": "Handle an in-flight weather hold or abort",
      "description": "",
      "prompt": "On a wind, visibility or mechanical trigger, bring the drone to a safe hold or return-to-land immediately, notify the dispatcher, and record the abort reason before any re-attempt is scheduled.",
      "ordinality": 3,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "499d45de-dbad-4e8b-8ed5-8bd4d0e062ac"
    },
    {
      "id": "dc725ee3-05db-4618-8d3d-152fb972b2e5",
      "code": "WI-8",
      "workflow_id": "bac550da-96dc-45b5-bf98-d1fcd7868dd8",
      "title": "Complete the post-flight spray log and client sign-off",
      "description": "",
      "prompt": "File the post-flight log within 24 hours: chemical used, actual rate applied, area covered, start/end time, and any deviation from the prescription. Get the client's or field contact's acknowledgement before closing the job.",
      "ordinality": 4,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "f222e7d6-7a29-4f7f-b08a-f1d7cd2c8d37"
    },
    {
      "id": "af975bfd-53ab-44f3-bc24-c467c97fab19",
      "code": "WI-9",
      "workflow_id": "6052641d-4aaa-4051-b1b6-273758244137",
      "title": "Perform scheduled maintenance and battery health check",
      "description": "",
      "prompt": "Run the maintenance interval checklist for each airframe: motor wear, propeller condition, spray-pump calibration, and battery cycle-count/health. Pull any battery below the health threshold from active rotation.",
      "ordinality": 1,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "438c2278-235b-4f76-9942-f0a3c74d6ef5"
    },
    {
      "id": "98dad214-fe7c-4003-9261-3f2573e271f5",
      "code": "WI-10",
      "workflow_id": "6052641d-4aaa-4051-b1b6-273758244137",
      "title": "Investigate and repair a fault-flagged drone",
      "description": "",
      "prompt": "Diagnose a drone flagged fault or incident before it flies again: inspect the component implicated by the telemetry log, repair or replace it, and re-run the full pre-flight checklist before returning it to service.",
      "ordinality": 2,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "438c2278-235b-4f76-9942-f0a3c74d6ef5"
    },
    {
      "id": "5b12754c-eb1a-4ac4-85ff-d599c89e90cb",
      "code": "WI-11",
      "workflow_id": "3bc20768-3ad5-4b27-a42e-3ed66a7495b4",
      "title": "Generate the per-hectare invoice for a completed job",
      "description": "",
      "prompt": "Invoice the client from the closed job's actual hectares covered and the agreed per-hectare rate, not the originally quoted area — reconcile against the post-flight spray log before sending.",
      "ordinality": 1,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "274e2941-c169-4693-ae20-bcba8622c60f"
    },
    {
      "id": "dfd4b2a2-19ff-43a2-bdf0-bf28de13066c",
      "code": "WI-12",
      "workflow_id": "3bc20768-3ad5-4b27-a42e-3ed66a7495b4",
      "title": "Reconcile fuel/battery cost against job revenue",
      "description": "",
      "prompt": "Post battery-charging and fuel costs for the period against the jobs they served, and confirm gross margin per job is within the expected range before month-end close.",
      "ordinality": 2,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "274e2941-c169-4693-ae20-bcba8622c60f"
    },
    {
      "id": "fbe73f70-c117-48c2-91e1-ee9ae4c77882",
      "code": "WI-13",
      "workflow_id": "3bc20768-3ad5-4b27-a42e-3ed66a7495b4",
      "title": "File the pesticide application record with the regulator",
      "description": "",
      "prompt": "Submit the statutory pesticide-application record for the period to the relevant regulator, cross-checked against every post-flight spray log filed that period.",
      "ordinality": 3,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "a568790a-9b7d-4c1a-b097-d6c723103901"
    },
    {
      "id": "e82289f3-af37-4c4c-9af3-0ea85d2717f2",
      "code": "WI-14",
      "workflow_id": "3bc20768-3ad5-4b27-a42e-3ed66a7495b4",
      "title": "Renew a remote pilot license or aircraft registration",
      "description": "",
      "prompt": "Track every pilot license and aircraft registration expiry date; start the renewal at least 30 days before expiry and ground the affected pilot or airframe if it lapses.",
      "ordinality": 4,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "bec74f46-59f1-41d2-afd4-216e6f344d72"
    },
    {
      "id": "a089b67d-6f38-42dd-9140-fae8345c0a68",
      "code": "WI-15",
      "workflow_id": "3bc20768-3ad5-4b27-a42e-3ed66a7495b4",
      "title": "Run the quarterly spill-response drill",
      "description": "",
      "prompt": "Rehearse the chemical-spill response procedure with ground crew: containment kit location, spill reporting line, and PPE donning. Log attendance and any gaps found.",
      "ordinality": 5,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "a9916028-d258-47cd-8448-c8dfd1faafa3"
    },
    {
      "id": "d3b49b56-674b-4767-be32-533b1ccbfeaf",
      "code": "WI-16",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Onboard a new farmer client with a signed contract",
      "description": "",
      "prompt": "Walk a new client through service area, pricing and the field-boundary submission process, and get a signed spray-service contract on file before the first job is scheduled.",
      "ordinality": 5,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "bd5414f3-b1fb-413d-b1dd-4fdfe9a5444f"
    },
    {
      "id": "76efb430-ea11-4f16-b67c-627290fa4e92",
      "code": "WI-17",
      "workflow_id": "595a47bf-6b92-4882-b2fc-4afded0971db",
      "title": "Pitch the crop-health monitoring upsell",
      "description": "",
      "prompt": "Offer existing spray clients a multispectral/NDVI monitoring add-on using flight data already being collected; quote it as a per-season package, not a one-off flight.",
      "ordinality": 6,
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false,
      "objective_id": "16cc9277-5957-42ff-ad3b-a738b796a104"
    },
    {
      "id": "22e95cac-fe3c-53b7-a052-333372ca9a55",
      "code": "WI-18",
      "workflow_id": "6052641d-4aaa-4051-b1b6-273758244137",
      "objective_id": "438c2278-235b-4f76-9942-f0a3c74d6ef5",
      "title": "Review the maintenance backlog and ground overdue airframes",
      "description": "",
      "prompt": "Compare every airframe's maintenance interval and battery cycle count with the schedule. Ground any airframe that is past its interval and tell the dispatcher so no job is booked on it until it is cleared.",
      "ordinality": 3,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "543c1b4e-3f4d-5c47-8103-a230e759a782",
      "code": "WI-19",
      "workflow_id": "b8177152-69eb-5834-8e37-010f5a0945d5",
      "objective_id": "770a6585-8912-5419-a8d0-bd25a701cf5f",
      "title": "List the threats to the operation",
      "description": "",
      "prompt": "List the threats the operation faces this quarter: drift onto neighbouring land, a loss of control over people or water, a lithium battery fire, a lapsed licence or registration, a pesticide spill or operator exposure. For each, write the consequence if it happens, from the flight logs, incident notes and near misses of the quarter.",
      "ordinality": 1,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "0f3bc189-0e4b-57b4-b039-ded87247bbcf",
      "code": "WI-20",
      "workflow_id": "b8177152-69eb-5834-8e37-010f5a0945d5",
      "objective_id": "770a6585-8912-5419-a8d0-bd25a701cf5f",
      "title": "Check the controls against each threat",
      "description": "",
      "prompt": "For each threat, list the preventive measures that stop it and the mitigating measures that limit the harm, and who holds each. Mark a control as relying on one person, one checklist or one piece of kit.",
      "ordinality": 2,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "ef62f95e-33cb-5c41-b9dd-dbc87376e956",
      "code": "WI-21",
      "workflow_id": "b8177152-69eb-5834-8e37-010f5a0945d5",
      "objective_id": "770a6585-8912-5419-a8d0-bd25a701cf5f",
      "title": "Find the gaps",
      "description": "",
      "prompt": "Name every threat with no preventive measure, no mitigating measure, or a control that was skipped or failed in the quarter. Rank the gaps by consequence and give the reason for each rank.",
      "ordinality": 3,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "d57a92f9-a428-55a0-8830-629a71bcb6d7",
      "code": "WI-22",
      "workflow_id": "b8177152-69eb-5834-8e37-010f5a0945d5",
      "objective_id": "770a6585-8912-5419-a8d0-bd25a701cf5f",
      "title": "Raise the work that closes each gap",
      "description": "",
      "prompt": "Draft one piece of work per gap, with an owner and a due date, for the Safety Officer to approve. Put the closing work on the board and carry open gaps into next quarter's review.",
      "ordinality": 4,
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
