  "values": [
    {
      "id": "751510b0-0299-43b5-a148-cda5d8088965",
      "code": "V-1",
      "text": "We never fly outside the authorized permit radius, no exceptions.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "2080989a-16b6-4b2f-8d5c-4b556a1393da",
      "code": "V-2",
      "text": "Client fields and farm data belong to the client — we never share flight or yield data without consent.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "7a080eaf-460e-4334-9c10-fc83b1615283",
      "code": "V-3",
      "text": "Safety of people and livestock on the ground always outweighs meeting a job deadline.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "13064047-0962-4828-b8da-02c83c8b348b",
      "code": "V-4",
      "text": "We only spray what the product label and prescription authorize — no freelancing chemical mixes.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "30e18f4b-50de-48b4-b88d-34f23c260188",
      "code": "RU-1",
      "text": "Every flight requires a pre-flight airworthiness checklist signed off before takeoff.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "417bdd59-6105-4ce4-9057-9d3798cb2917",
      "code": "RU-2",
      "text": "No spray flight proceeds when wind speed exceeds the product label's maximum or a weather hold is in effect.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "26720f06-8094-4c59-b90c-cab34943d210",
      "code": "RU-3",
      "text": "Every completed job must have a post-flight spray log filed within 24 hours, including chemical, rate and area covered.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "b0c2c4f2-1d77-483e-8817-514a7e062e3d",
      "code": "RU-4",
      "text": "Pesticide application records are retained for the statutory minimum period and never altered after filing.",
      "created_at": "2026-09-19T00:58:14Z",
      "last_updated": "2026-09-19T00:58:14Z",
      "deleted": false
    },
    {
      "id": "fe089702-875b-5427-a424-e33955fc56ad",
      "code": "RU-5",
      "text": "No spray pass is flown within the label's drift buffer of a dwelling, a road, a water body or a neighbouring crop that is not on the contract.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "0338de6a-175d-5cd6-9174-ec9ab19838e8",
      "code": "RU-6",
      "text": "Nobody stands under or within the safety radius of a drone that is armed or in flight; the pilot aborts if anyone enters it.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "1f93015d-826f-5f46-bd37-0a9288455ee5",
      "code": "RU-7",
      "text": "Lithium batteries are charged only in the fireproof charging area, never left charging unattended, and a swollen or damaged pack is retired the same day.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "d3cba906-618f-5d72-ab01-5cff760df5d1",
      "code": "RU-8",
      "text": "A pilot whose licence or an airframe whose registration has lapsed is grounded until the renewal is on file.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "a18505d5-e71f-5077-b87b-70e12146810a",
      "code": "RU-9",
      "text": "Ground crew wear the label's required protective equipment whenever they mix, load or clean, and every spill is reported to the Safety Officer the same day.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "337d487b-6417-503c-a23e-d6e2ee102d3d",
      "code": "RU-10",
      "text": "The risk review runs every quarter, and each gap it finds has a named owner and a due date before the review is closed.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
