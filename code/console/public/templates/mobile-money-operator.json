  "values": [
    {
      "id": "43cbf083-7d49-4ecb-b098-4bb3013a10bf",
      "code": "V-1",
      "text": "Financial inclusion comes first — no unbanked customer left out",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    },
    {
      "id": "2a9cdf55-6eaf-4198-a327-b6b5cb79e120",
      "code": "V-2",
      "text": "Zero tolerance for money laundering, however small the transaction",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    },
    {
      "id": "f3751c8a-7f5a-417a-bd34-afc84b984107",
      "code": "V-3",
      "text": "Agent trust is the network's backbone — protect it",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "8a7e9b73-a7f3-42cf-acc2-cff6422394c5",
      "code": "RU-1",
      "text": "No agent may be activated before passing KYC/AML vetting",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    },
    {
      "id": "eb9cab0c-a582-427f-89c5-79a814bedc6d",
      "code": "RU-2",
      "text": "Suspicious transactions must be reported to the FIU within the regulatory deadline",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    },
    {
      "id": "89ff1c91-d359-40f1-a70b-7757231d600f",
      "code": "RU-3",
      "text": "Customer float and operating funds are never commingled",
      "created_at": "2026-09-16T23:37:06Z",
      "last_updated": "2026-09-16T23:37:06Z",
      "deleted": false
    },
    {
      "id": "7154c0c9-82a2-5247-ba44-ca5820f8fcdf",
      "code": "RU-4",
      "text": "A new account may not send or cash out above the daily threshold until its KYC review is complete.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "ba0a70e9-833f-587f-86da-6e3ffcac35d1",
      "code": "RU-5",
      "text": "A transfer out within 24 hours of a SIM swap needs a second verification from the customer.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "bb1df8ee-347b-5ac2-894d-e54fb409716d",
      "code": "RU-6",
      "text": "Agent float is reconciled to the trust account every day, and a shortfall is escalated the same day.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "ead620c8-167d-5ff0-846a-69ba25ad1b34",
      "code": "RU-7",
      "text": "An outage past 30 minutes is declared an incident and the failover is tested every quarter.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "8febb9f2-8cf1-54e6-a2a8-da4a36e2e72d",
      "code": "RU-8",
      "text": "Customer ID documents are opened only by the KYC Analyst, and every access is logged.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    },
    {
      "id": "1065e837-8142-5904-b27e-a31b6ff57582",
      "code": "RU-9",
      "text": "Every recorded risk has an owner and a review date, and each gap found raises work within five days.",
      "created_at": "2026-11-01T00:00:00Z",
      "last_updated": "2026-11-01T00:00:00Z",
      "deleted": false
    }
  ],
