  "values": [
    {
      "id": "e206ff31-8bfa-5557-bf75-cb6f8f73a96d",
      "code": "V-1",
      "text": "The hub and its riders serve the whole community; what the AI roles do is always something a person could do and a person can check.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    }
  ],
  "rules": [
    {
      "id": "ed47f3b4-2227-53c2-b800-98f0ec72b716",
      "code": "RU-1",
      "text": "A customer asks for a ride in the app with a pickup place and a destination, sees the available riders with their fares, and picks the rider she wants.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "ff9111ca-046a-5116-8535-2c2abf3f24b6",
      "code": "RU-2",
      "text": "A ride is the rider's only after he says yes, and the customer is told he is coming, and in how many minutes, only after that.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "36f569e5-1672-5467-b3ff-7a231f6af8d4",
      "code": "RU-3",
      "text": "If a rider says no, the customer picks another rider herself. If a rider does not answer, nothing happens: no timer runs, no one else is asked, and she decides whether to wait, pick another rider or cancel.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "b0b51a2a-52b7-589e-be81-5fc96c2eff2c",
      "code": "RU-4",
      "text": "A rider is shown to customers only while he has said he is available, and a rider on a trip is not shown.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "8055d1a2-3ce0-50f9-b62d-a5a859f84162",
      "code": "RU-5",
      "text": "Riders own their bikes; the hub does not allocate bikes to riders.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "acb9b8c8-158f-58eb-ab53-49b64449a802",
      "code": "RU-6",
      "text": "Riders set their own fares. The Dispatcher sets no fare, chooses no rider, says yes for no one and takes no payment.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "2ce66fb4-a057-54ae-a699-1cc6cd540260",
      "code": "RU-7",
      "text": "An asset is registered with the fields its type needs, such as a serial number or a member login, and the Assets Keeper records the member who holds it; changing the holder needs the hub manager's approval.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "5fd8fa11-ca48-5fbc-b583-ceb508c25120",
      "code": "RU-8",
      "text": "The Network Watcher alerts the hub manager once for each fault and does not repeat the alert while the fault stands.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "b4e84716-9e5a-5a11-844c-640d537b19df",
      "code": "RU-9",
      "text": "Every AI role acts only through tools the agency permits, and none approves its own drafts.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "8f762ba4-4dee-5a6c-babe-2c6387814cde",
      "code": "RU-10",
      "text": "Hub Steward answers in the language the member writes in, from the hub's documents.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    }
  ],
