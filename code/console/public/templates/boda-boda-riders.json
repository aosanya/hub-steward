  "roles": [
    {
      "id": "8673d0fd-efbf-57ec-bcd5-6e3eabd6a5dd",
      "code": "R-1",
      "name": "Hub manager",
      "description": "Runs the hub and the riders' group. Approves what the AI roles draft, hears about network faults and sees what every AI role is doing. This role is held by a person.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "8c9b9441-a29a-5fe6-ad66-464b08d8ee10",
      "code": "R-2",
      "name": "Member",
      "description": "A registered member of the hub. Asks Hub Steward questions in the hub's chat and may hold assets the hub lends.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "a13d7a95-ee45-5e6c-b3a1-acd786be1375",
      "code": "R-3",
      "name": "Rider",
      "description": "A member who offers rides on his own bike. Switches himself available, posts his fare for each trip he rides, says yes or no to the ask of the customer who picked him, tells her in how many minutes he is coming, and marks the trip paid.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false,
      "permissions": [
        "market.browse",
        "market.offer"
      ]
    },
    {
      "id": "489ffc0a-8fda-55c0-b942-b03690aff63f",
      "code": "R-4",
      "name": "Customer",
      "description": "A member of the app who asks for a ride from one place to another, sees the available riders with their fares, and picks the rider she wants. She is told he is coming only after his yes.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "b3f85171-147d-50bb-ad4a-025b99c9388c",
      "code": "R-5",
      "name": "Hub Steward",
      "permissions": [
        "ai.use",
        "chat.post",
        "chat.thread",
        "document.read",
        "document.search",
        "form.answers.read",
        "form.compose",
        "form.send",
        "group.read",
        "market.ask",
        "market.browse",
        "member.read"
      ],
      "description": "The hub's AI agent. Answers members in the hub's chat from the hub's documents, in the language the member writes in, and drafts access requests for the hub manager to approve. It never approves its own drafts.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "e3455341-7b00-579c-8fd0-e63a4db90c7d",
      "code": "R-6",
      "name": "Dispatcher",
      "description": "An AI role. Asks only the rider the customer picked, once, and tells the customer his answer. It chooses no rider, sets no fare, says yes for no one and takes no payment; when a rider does not answer it does nothing.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-29T00:00:00Z",
      "deleted": false
    },
    {
      "id": "210cf8de-6b56-51ca-934c-c74928390815",
      "code": "R-7",
      "name": "Assets Keeper",
      "description": "An AI role. Registers the hub's assets with the fields their type needs, such as a serial number or a member login, and records which member holds each one. It answers who holds what.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    },
    {
      "id": "ad56beff-3190-5777-a426-af31998a6b10",
      "code": "R-8",
      "name": "Network Watcher",
      "description": "An AI role. Reads the hub's simulated network state and tells the hub manager when a device goes to fault, once per fault.",
      "created_at": "2026-10-26T00:00:00Z",
      "last_updated": "2026-10-26T00:00:00Z",
      "deleted": false
    }
  ],
